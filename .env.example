# Server Environment Variables (copy to server/.env)
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/water_treatment_db?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=https://your-app.vercel.app
NODE_ENV=production

# Client Environment Variables (set in Vercel dashboard as VITE_API_URL)
# VITE_API_URL=https://your-backend.onrender.com
